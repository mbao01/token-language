{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "strict": true,
    "outDir": "out",
    "rootDir": "./",
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./types/*"]
    }
  },
  "include": ["src", "types"],
  "exclude": ["node_modules", ".vscode-test"]
}
