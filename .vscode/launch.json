// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Token Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": [
        "${workspaceFolder}/packages/client/out/**/*.js",
        "${workspaceFolder}/packages/server/out/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}",
      "autoAttachChildProcesses": true
    },
    {
      "name": "E2E: Run Token Extension tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/client/out/test/runTest.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "pnpm:compile:e2e",
      "env": {
        "CODE_TESTS_PATH": "${workspaceFolder}/packages/client/out/test",
        "CODE_TESTS_WORKSPACE": "${workspaceFolder}/packages/client/testFixture"
      },
      "outFiles": [
        "${workspaceFolder}/packages/client/out/**/*.js",
        "${workspaceFolder}/packages/server/out/**/*.js"
      ]
    }
  ]
}
